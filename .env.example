# Convex Backend URL
# For local development, this defaults to http://localhost:3210
# For production, get this from your Convex dashboard after deploying
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210

# Convex HTTP-actions site URL used as the Convex Auth issuer
# Production values use the deployment's https://*.convex.site URL
CONVEX_SITE_URL=http://localhost:3211

# Server-only pepper used by Next.js before passcode material crosses into Convex
# Set the same long random value only in the Next.js server environment
PROFILE_PASSCODE_PEPPER=

# Shared server-only secret for the Next.js to Convex profile-access boundary
# Set the same long random value in Next.js and Convex; never prefix with NEXT_PUBLIC_
PROFILE_ACCESS_SERVICE_SECRET=

# Public Next.js application URL used for links and metadata
# Examples: http://localhost:3000 (local), https://yourdomain.com (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel-managed custom domains (disabled by default; server environments only)
CUSTOM_DOMAINS_ENABLED=false
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Comma-separated exact trusted app authorities; no wildcards (primary site is included automatically)
PLATFORM_HOSTS=localhost:3000

# (Optional) Trusted client IP header for PDF rate limiting on other platforms
# Configure only when your reverse proxy overwrites this header; values must be IP addresses
# PDF_TRUSTED_IP_HEADER=x-forwarded-for

# Optional AI writing (disabled by default; all values are server-only except the UI flag)
# Both flags must be exactly true before the UI and server adapter are enabled.
NEXT_PUBLIC_AI_WRITING_ENABLED=false
AI_WRITING_ENABLED=false
OPENAI_API_KEY=
# Required when AI_WRITING_ENABLED=true; set an explicitly supported model for your account.
OPENAI_MODEL=

# Optional weekly aggregate analytics email (disabled by default; Convex server only)
ANALYTICS_DIGEST_ENABLED=false

# Resend API key for email OTP sign-in
# Get yours at https://resend.com → API Keys
# Set this in the Convex dashboard under Settings → Environment Variables
AUTH_RESEND_KEY=re_xxxxxxxxxxxx

# (Optional for OTP; required for analytics digests) verified sender address
# Requires a verified domain in Resend. Defaults to onboarding@resend.dev
# AUTH_EMAIL=OpenCV <noreply@yourdomain.com>
