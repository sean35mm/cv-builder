# Convex Backend URL
# For local development, this defaults to http://localhost:3210
# For production, get this from your Convex dashboard after deploying
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210

# Convex HTTP-actions site URL used as the Convex Auth issuer
# Production values use the deployment's https://*.convex.site URL
CONVEX_SITE_URL=http://localhost:3211

# Public Next.js application URL used for links and metadata
# Examples: http://localhost:3000 (local), https://yourdomain.com (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Optional) Trusted client IP header for PDF rate limiting on other platforms
# Configure only when your reverse proxy overwrites this header; values must be IP addresses
# PDF_TRUSTED_IP_HEADER=x-forwarded-for

# Resend API key for email OTP sign-in
# Get yours at https://resend.com → API Keys
# Set this in the Convex dashboard under Settings → Environment Variables
AUTH_RESEND_KEY=re_xxxxxxxxxxxx

# (Optional) Sender email address for OTP emails
# Requires a verified domain in Resend. Defaults to onboarding@resend.dev
# AUTH_EMAIL=OpenCV <noreply@yourdomain.com>
