{
  "name": "opencv-builder",
  "version": "0.4.1",
  "description": "A modern, full-stack CV builder with live editing, drag-and-drop, and SEO-friendly public profiles",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sean35mm/cv-builder.git"
  },
  "author": "Sean Gil",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sean35mm/cv-builder/issues"
  },
  "homepage": "https://github.com/sean35mm/cv-builder#readme",
  "keywords": [
    "cv-builder",
    "resume-builder",
    "cv builder",
    "resume builder",
    "portfolio",
    "convex",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "open-source",
    "personal website",
    "online resume",
    "online cv",
    "opencv app"
  ],
  "scripts": {
    "build": "next build",
    "check": "bun test && bun run lint && bun run build",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:backend": "convex dev --tail-logs=disable --typecheck try",
    "dev:frontend": "next dev",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && eslint . --max-warnings 0 --ignore-pattern '.next/*' --ignore-pattern '.turbo/*' --ignore-pattern 'dist/*' --ignore-pattern 'next-env.d.ts'",
    "release:check": "./scripts/release.sh check",
    "release:prepare": "./scripts/release.sh prepare",
    "start": "next start",
    "test": "bun test"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.94",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@node-rs/argon2": "2.0.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.0",
    "docx": "9.7.1",
    "fflate": "0.8.3",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.16",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "openai": "6.48.0",
    "papaparse": "5.5.4",
    "qrcode": "1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "7.0.17",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.9",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "npm-run-all2": "9.0.2",
    "postcss": "8.5.15",
    "prettier": "^3.8.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "brace-expansion": "1.1.13",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.15"
  }
}
